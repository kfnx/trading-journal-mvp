# ─────────────────────────────────────────────
# Trading Journal MVP — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── AI Chat (OpenRouter) ──────────────────────
# Required to enable the AI Chat feature.
# Get a free key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: model to use (defaults to anthropic/claude-3-haiku)
# Any model ID from https://openrouter.ai/models works here.
# Examples:
#   VITE_OPENROUTER_MODEL=anthropic/claude-3-haiku
#   VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
#   VITE_OPENROUTER_MODEL=google/gemini-flash-1.5
VITE_OPENROUTER_MODEL=anthropic/claude-3-haiku
